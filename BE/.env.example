PORT=5000
NODE_ENV=development
JWT_SECRET=generate_a_random_64_char_string_here
SESSION_SECRET=generate_another_random_64_char_string_here
MONGO_URI=mongodb://localhost:27017/studyrandom
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Metered WebRTC credentials
METERED_DOMAIN=your_metered_domain_here
METERED_API_KEY=your_metered_api_key_here
METERED_USERNAME=your_metered_username_here
METERED_PASSWORD=your_metered_password_here

# PayOS Payment
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Cloudinary
CLOUDINARY_URL=your_cloudinary_url

# Admin seed account (used ONLY on first startup to create admin user)
ADMIN_EMAIL=admin@studyrandom.com
ADMIN_PASSWORD=change_this_to_a_strong_password
